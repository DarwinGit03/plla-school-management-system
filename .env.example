# Copy this file to .env and replace the values with credentials from your SMTP provider.
# Keep .env private; it is excluded from Git and blocked by the web server rules.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_ENCRYPTION="tls"
SMTP_USERNAME="your-smtp-account@example.com"
SMTP_PASSWORD="replace-with-your-provider-app-password"
SMTP_FROM_EMAIL="your-verified-sender@example.com"
SMTP_FROM_NAME="PLLA School Management"
# Optional. Defaults to PHP's openssl.cafile value when omitted.
SMTP_CA_FILE="C:/xampp/php/extras/ssl/cacert.pem"
